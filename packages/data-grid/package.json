{
  "name": "@byterygon/data-grid",
  "version": "0.0.0",
  "description": "The virtualized Arrow data grid: reads ArrowBatch buffers directly, streams with backpressure, ARIA grid pattern; styled with design-token roles only.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/data-grid.css"
  },
  "files": [
    "src",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "demo": "vite --config vite.config.ts demo --host 127.0.0.1 --port 5179 --strictPort"
  },
  "dependencies": {
    "@byterygon/ambidex": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@byterygon/design-tokens": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "apache-arrow": "21.2.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
