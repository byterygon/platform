        "bytes": {
          "description": "Arrow IPC bytes sent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "chunks": {
          "description": "Chunks (Ambidex stream frames) sent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "connect_ms": {
          "description": "Opening the database connection through the broker.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "first_chunk_ms": {
