        "DeadlineExceeded",
        "Unauthenticated",
        "PermissionDenied",
        "ApprovalRequired",
        "InvalidArgument",
        "NotFound",
        "FailedPrecondition",
        "ResourceExhausted",
        "Unavailable",
        "Unimplemented",
        "VersionMismatch",
        "Internal"
      ],
      "type": "string"
    }
