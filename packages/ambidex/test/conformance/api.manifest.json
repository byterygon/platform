{
  "$defs": {
    "ApprovalRequiredDetails": {
      "description": "`details` of an `ApprovalRequired` error raised by the authorizer: the id of the recorded\napproval request.",
      "properties": {
        "approval_id": {
          "type": "string"
        }
      },
      "required": [
        "approval_id"
      ],
      "type": "object"
    },
    "Code": {
      "description": "Error codes, spec §10. Serialized as the variant name so TypeScript can narrow on\n`e.code === \"ApprovalRequired\"`.",
      "enum": [
        "Cancelled",
        "DeadlineExceeded",
        "Unauthenticated",
        "PermissionDenied",
        "ApprovalRequired",
        "InvalidArgument",
        "NotFound",
        "FailedPrecondition",
        "ResourceExhausted",
        "Unavailable",
        "Unimplemented",
        "VersionMismatch",
        "Internal"
      ],
      "type": "string"
    },
    "CounterEnd": {
      "description": "What [`FixtureApi::counter`] does after its last event.",
      "oneOf": [
        {
          "const": "finish",
          "description": "Ends normally: `Result` with payload `null`.",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "Ends with `FailedPrecondition` and a typed [`FixtureError`] in `details`.",
          "type": "string"
        },
        {
          "const": "wait",
          "description": "Waits for its token (Cancel, Unsubscribe, deadline, revocation, disconnect), records\n[`Event::Cancelled`], then returns `Ok` (which the client must never see).",
          "type": "string"
        },
        {
          "const": "hang",
          "description": "Ignores its token; only dropping its future stops it.",
          "type": "string"
        }
      ]
    },
    "CounterInput": {
      "description": "Input of [`FixtureApi::counter`].",
      "properties": {
        "count": {
          "description": "Events sent: 0, 1, …, `count - 1`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "then": {
          "$ref": "#/$defs/CounterEnd",
          "default": "finish"
        }
      },
      "required": [
        "count"
      ],
      "type": "object"
    },
    "FailInput": {
      "description": "Input of [`FixtureApi::fail`].",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "FixtureError": {
      "description": "The typed domain error of [`FixtureApi::fail`].",
      "oneOf": [
        {
          "properties": {
            "code": {
              "$ref": "#/$defs/Code"
            },
            "kind": {
              "const": "Requested",
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "code",
            "retryable"
          ],
          "type": "object"
        }
      ]
    }
  },
