{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Byterygon UI component manifest",
  "description": "What a person, an agent or a tool needs to use a component without reading its source (spec section 9a.3). scripts/lib/manifest.ts validates the same shape in the tests and the registry build.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "title", "description", "status", "base", "dependencies", "props", "variants", "slots", "states", "tokens", "examples", "accessibility"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "description": "kebab-case; the folder, the file names and the registry item name." },
    "title": { "type": "string", "description": "PascalCase of the name; the exported component." },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["experimental", "stable"] },
    "base": { "type": ["string", "null"], "pattern": "^@base-ui/react/", "description": "The Base UI module the component wraps, or null." },
    "dependencies": { "type": "array", "items": { "type": "string" }, "description": "npm packages the component imports, besides React." },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": { "type": ["string", "number", "boolean", "null"] },
          "required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "variants": {
      "type": "object",
      "description": "Variant prop to its values; the same as the <name>Variants export.",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "element", "description"],
        "properties": { "name": { "type": "string" }, "element": { "type": "string" }, "description": { "type": "string" } }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "variant", "description"],
        "properties": {
          "name": { "type": "string" },
          "variant": { "type": "string", "description": "The Tailwind variant that styles the state (hover, focus-visible, data-disabled, aria-invalid)." },
          "props": { "type": "object", "description": "Props that put the component in the state." },
          "description": { "type": "string" }
        }
      }
    },
    "tokens": { "type": "array", "items": { "type": "string" }, "description": "Every token path the classes resolve to, sorted. The tests derive it and compare." },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimal", "realistic"],
      "properties": { "minimal": { "type": "string" }, "realistic": { "type": "string" } }
    },
    "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
