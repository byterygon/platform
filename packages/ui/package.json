{
  "name": "@byterygon/ui",
  "version": "0.0.0",
  "description": "Byterygon UI: Base UI components styled with design-token roles, distributed as a self-hostable shadcn registry.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./registry/*": "./registry/*",
    "./component.manifest.schema.json": "./component.manifest.schema.json"
  },
  "files": [
    "registry",
    "src",
    "component.manifest.schema.json",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "gallery": "vite",
    "registry": "node scripts/registry.ts",
    "registry:check": "node scripts/registry.ts --check",
    "new": "node scripts/new-component.ts",
    "verify:install": "node scripts/verify-install.ts",
    "check:browser": "node scripts/browser-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-form": "1.33.5",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "monaco-editor": "0.57.0",
    "react-day-picker": "10.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@byterygon/design-tokens": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "class-variance-authority": "0.7.1",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.2",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
